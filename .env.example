NODE_ENV=production
PUBLIC_URL=https://yourdomain.com
SESSION_SECRET=paste-output-of: openssl rand -hex 32
NOTIFY_WEBHOOK_URL=
# How the real visitor IP is found (used for rate limits). Behind one proxy such as Caddy: TRUST_PROXY=1.
# On Render: CLIENT_IP_HEADER=true-client-ip. On Cloudflare (orange cloud): cf-connecting-ip. On Fly.io: fly-client-ip.
TRUST_PROXY=1
CLIENT_IP_HEADER=

# ---------- Team sign-in ----------
# Team password (12+ characters). Changing it signs everyone out. Turns off automatically when Google sign-in is
# configured, unless ALLOW_PASSWORD_LOGIN=true.
INBOX_PASSWORD=change-me-to-something-long
ALLOW_PASSWORD_LOGIN=

# Google sign-in via Firebase (free Spark plan, no card). Values from Firebase → Project settings → Your apps → Web app.
# These are public by design (they end up in the browser); access is controlled by TEAM_EMAILS on the server.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Who may sign in. Separate with commas. "@company.com" allows everyone with an address at that domain.
TEAM_EMAILS=

# ---------- Cloudflare R2: chat files + database backups ----------
# Leave empty to keep both off. Keep the token SECRET and scoped to this one bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Safety caps, enforced by the app, kept far under R2's free tier (10 GB, 1M writes, 10M reads a month).
# When a cap is reached, file sharing pauses until next month; chat keeps working.
R2_MONTHLY_WRITE_CAP=300000
R2_MONTHLY_READ_CAP=3000000
STORAGE_CAP_MB=5000
FILE_MAX_MB=10
UPLOADS_PER_DAY=300
# FILE_UPLOADS=off   # use R2 only for backups
BACKUP_INTERVAL_SEC=180
BACKUP_KEEP_DAYS=14
