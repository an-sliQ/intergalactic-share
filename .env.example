NODE_ENV=production
# 12+ characters. Changing it signs everyone out of the inbox.
INBOX_PASSWORD=change-me-to-something-long
SESSION_SECRET=paste-output-of: openssl rand -hex 32
PUBLIC_URL=https://yourdomain.com
NOTIFY_WEBHOOK_URL=
# How the real visitor IP is found (used for rate limits). Behind one proxy such as Caddy: TRUST_PROXY=1.
# On Cloudflare (orange cloud) use CLIENT_IP_HEADER=cf-connecting-ip; on Fly.io CLIENT_IP_HEADER=fly-client-ip.
TRUST_PROXY=1
CLIENT_IP_HEADER=
