NODE_ENV=production
PUBLIC_URL=https://yourdomain.com
# The email shown on the contact page (buttons, footer, FAQ). Change it any time; no code edits needed.
CONTACT_EMAIL=hello@cairnly.studio
SESSION_SECRET=paste-output-of: openssl rand -hex 32
NOTIFY_WEBHOOK_URL=
# How the real visitor IP is found (used for rate limits). Behind one proxy such as Caddy: TRUST_PROXY=1.
# On Render: CLIENT_IP_HEADER=true-client-ip. On Cloudflare (orange cloud): cf-connecting-ip. On Fly.io: fly-client-ip.
TRUST_PROXY=1
CLIENT_IP_HEADER=

# ---------- Team sign-in ----------
# Team password (12+ characters). Changing it signs everyone out. Turns off automatically when Google sign-in
# (Supabase) is configured, unless ALLOW_PASSWORD_LOGIN=true.
INBOX_PASSWORD=change-me-to-something-long
ALLOW_PASSWORD_LOGIN=

# ---------- Supabase (free plan, no card): files, backups and Google sign-in ----------
# Project Settings → Data API (URL) and → API Keys. See GO-LIVE.md.
SUPABASE_URL=
# Public by design. Enables "Continue with Google" on /inbox (after the Google provider is turned on in Supabase).
SUPABASE_PUBLISHABLE_KEY=
# PRIVATE. Server only. Enables file sharing + automatic backups (bucket "chat" is created privately on first start).
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=chat
# Who may sign in with Google. Separate with commas. "@company.com" allows everyone with an address at that domain.
TEAM_EMAILS=

# Safety stops, kept under Supabase Free (1 GB storage, 5 GB downloads a month). When reached, file sharing pauses
# until next month; chat keeps working.
STORAGE_CAP_MB=800
EGRESS_CAP_MB=3500
FILE_MAX_MB=10
UPLOADS_PER_DAY=300
# FILE_UPLOADS=off   # use Supabase only for backups
BACKUP_INTERVAL_SEC=180
BACKUP_KEEP_DAYS=14
