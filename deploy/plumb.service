# /etc/systemd/system/plumb.service — keeps the app running and restarts it on crash or reboot.
[Unit]
Description=Plumb contact page and live chat
After=network.target

[Service]
User=plumb
WorkingDirectory=/opt/plumb
EnvironmentFile=/opt/plumb/.env
Environment=HOST=127.0.0.1 PORT=3000 DB_FILE=/opt/plumb/.data/chat.db
ExecStart=/usr/bin/node --no-warnings=ExperimentalWarning server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
